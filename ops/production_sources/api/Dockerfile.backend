FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/backend:/app

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends age \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir --requirement requirements.txt

COPY backend ./backend
COPY config ./config
COPY ingestion ./ingestion
COPY refresh_fixture_states.py ./
COPY scripts/check_fixture_integrity.py ./scripts/check_fixture_integrity.py
COPY ops/postgres_backup ./ops/postgres_backup

CMD ["sh", "-c", "uvicorn main:app --app-dir /app/backend --host 0.0.0.0 --port ${PORT:-8000}"]
